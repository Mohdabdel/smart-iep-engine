# Hostinger Node.js staging only — no real secrets in Git.
# Set these in Hostinger's environment/secret settings, never in VITE_* variables.
IEP_DEPLOY_TARGET=hostinger
NODE_ENV=production

# Existing Supabase project — use authorized values only.
# Browser-visible (publishable) credentials; never use service role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only credentials; required for admin-protected review archive.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider: direct OpenAI is opt-in and requires verified model access.
IEP_AI_PROVIDER=openai
OPENAI_API_KEY=
IEP_OPENAI_MODEL=

# Supabase Auth callback/redirect URLs must be authorized for the staging domain.
# Do not enable public staging until authentication, RLS, storage, and AI parity tests pass.

# Staging access gate (scripts/staging-gate.mjs). Owner sets values in Hostinger only.
STAGING_GATE_USER=
STAGING_GATE_PASS=
STAGING_GATE_SESSION_SECRET=
STAGING_GATE_SESSION_TTL=43200
